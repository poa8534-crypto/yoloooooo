TAVILY_API_KEY=
YOUTUBE_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_PRIMARY_MODEL=qwen3:14b
OLLAMA_FALLBACK_MODEL=qwen3:8b
DATABASE_URL=sqlite:///./data/venture_agents.db

GEMINI_API_KEY_1=
# Hermes's key. The engineer uses it only with ENGINEER_USE_BOTH_GEMINI_KEYS=true;
# both keys share one project quota, so it adds no capacity.
GEMINI_API_KEY_2=
GAME_PROJECT_DIR=C:/RobloxGames/game
GAME_BASE_BRANCH=master

# Backup model providers, tried after Antigravity when it is out of quota
# (ENGINEER_PROVIDERS, default antigravity,dahl,glm,deepseek,gemini,ollama). Each is
# skipped until its key is set. Model names are tried in order; set the exact
# id your provider's console shows if it differs.
DAHL_API_KEY=
DAHL_BASE_URL=https://inference.dahl.global/v1
ENGINEER_DAHL_MODELS=zai-org/GLM-5.3-Flash,deepseek-ai/DeepSeek-V4-Flash-0731,MiniMaxAI/MiniMax-M2.7
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/paas/v4
ENGINEER_GLM_MODELS=glm-5.2
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
ENGINEER_DEEPSEEK_MODELS=deepseek-chat
